# NORTHSTAR local development only. Synthetic data only; never use real patient data here.
APP_ENV=development
APP_NAME=NORTHSTAR Secure API
DATABASE_URL=sqlite:///./data/northstar_dev.sqlite3

# Configure only when a real Keycloak/OIDC realm is available.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=northstar-api
# Replace this with the exact ACR value verified in signed tokens from the configured identity provider.
OIDC_PRIVILEGED_ACR_VALUES=["REPLACE_WITH_VERIFIED_KEYCLOAK_ACR"]
OIDC_JWKS_TIMEOUT_SECONDS=5

# Fixed-window API limit, counted per connecting client address. Configure trusted proxy handling before deployment.
API_RATE_LIMIT_REQUESTS_PER_MINUTE=120
API_RATE_LIMIT_WINDOW_SECONDS=60
